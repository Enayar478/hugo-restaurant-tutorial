{{- $pieces := where .Site.RegularPages "Section" "garde-robe" -}}
{{- $out := slice -}}
{{- range $pieces -}}
  {{- $out = $out | append (dict
    "slug" .File.BaseFileName
    "titre" .Title
    "categorie" (.Params.categorie | default "autre")
    "couleur" (.Params.couleur | default "")
    "marque" (.Params.marque | default "")
    "saison" (.Params.saison | default slice)
    "statut" (.Params.statut | default "possede")
    "image" (partial "piece-image.html" .)
    "vignette" (partial "vignette.html" . | chomp)
    "url" .RelPermalink
  ) -}}
{{- end -}}
{{- dict "pieces" $out | jsonify -}}
